import ac ;
import ../../config/checks/config : requires ;

using zlib ;

constant c11-requires :
    [ requires
    cxx11_constexpr
    cxx11_decltype
    cxx11_hdr_tuple
    cxx11_template_aliases
    cxx11_variadic_templates
    ]
    ;

path-constant WEBSOCKET_ROOT : .. ;

project boost/websocket
    : requirements
      $(c11-requires)
      <link>shared:<define>BOOST_WEBSOCKET_DYN_LINK=1
      <link>static:<define>BOOST_WEBSOCKET_STATIC_LINK=1
    : usage-requirements
      <link>shared:<define>BOOST_WEBSOCKET_DYN_LINK=1
      <link>static:<define>BOOST_WEBSOCKET_STATIC_LINK=1
    : source-location $(WEBSOCKET_ROOT)
    ;

alias websocket_sources : [ glob-tree-ex ./src : *.cpp ] ;

explicit websocket_sources ;

lib boost_websocket
   : websocket_sources
   : requirements
     <library>/boost//buffers
     <library>/boost//http
     <library>/boost//url
     <include>../
     <define>BOOST_WEBSOCKET_SOURCE
   : usage-requirements
     <library>/boost//buffers
     <library>/boost//http
   ;

boost-install boost_websocket ;
