import testing ;
import ac ;

using zlib ;

project
    : requirements
      $(c11-requires)
      <library>/boost/ws_proto//boost_ws_proto
      [ ac.check-library /boost/rts//boost_rts_zlib : <library>/boost/rts//boost_rts_zlib : ]
      <source>../../../url/extra/test_suite/test_main.cpp
      <source>../../../url/extra/test_suite/test_suite.cpp
      <include>.
      <include>../../../url/extra/test_suite
      <warnings>extra
      <warnings-as-errors>on
      <target-os>darwin,<undefined-sanitizer>norecover:<link>static
    ;

local SOURCES =
    handshake.cpp
    ;

for local f in $(SOURCES)
{
#    run $(f) : : : ;
    run $(f) : target-name $(f:B)_ ;
}
